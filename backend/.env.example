# Required
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
JWT_SECRET="change-this-to-a-random-secret"

# Google Maps (for directions/places proxy)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Firebase Auth (optional — set USE_FIREBASE_AUTH=false to skip)
USE_FIREBASE_AUTH="false"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Meilisearch (for marketplace search)
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="masterKey"

# Optional
PORT=3000

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
WHATSAPP_ACCESS_TOKEN="your_whatsapp_permanent_access_token"
WHATSAPP_VERIFY_TOKEN="carpool_wa_webhook_secret_2026"
WHATSAPP_API_VERSION="v21.0"
